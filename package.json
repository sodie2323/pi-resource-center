{
	"name": "pi-resource-center",
	"version": "0.3.1",
	"description": "Pi package for browsing packages, skills, extensions, prompts, themes, and tools",
	"type": "module",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node --experimental-strip-types --import ./test/register-loader.mjs --test test/*.test.js",
		"typecheck": "tsc -p tsconfig.json",
		"check": "npm run typecheck && npm test"
	},
	"files": [
		"extensions",
		"src",
		"README.md"
	],
	"keywords": [
		"pi-package",
		"pi",
		"tui",
		"extensions",
		"themes",
		"resources"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sodie2323/pi-resource-center.git"
	},
	"homepage": "https://github.com/sodie2323/pi-resource-center#readme",
	"bugs": {
		"url": "https://github.com/sodie2323/pi-resource-center/issues"
	},
	"pi": {
		"extensions": [
			"./extensions"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.79.7",
		"@earendil-works/pi-tui": ">=0.79.7"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"typescript": "^5.9.3"
	},
	"license": "MIT"
}
